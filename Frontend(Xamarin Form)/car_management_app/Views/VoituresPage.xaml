<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:vm="clr-namespace:car_management_app.ViewModels"
             x:Class="car_management_app.Views.VoituresPage">
    <ContentPage.BindingContext>
        <vm:VoitureViewModel />
    </ContentPage.BindingContext>
    <StackLayout>
        <Label Text="Liste des Voitures" FontSize="Large" HorizontalOptions="Center" />
        <ListView ItemsSource="{Binding Voitures}" ItemTapped="OnItemTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Marque}" Detail="{Binding Modele}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <Button Text="Ajouter une voiture" Command="{Binding AjouterVoitureCommand}" />
    </StackLayout>
    
</ContentPage>
