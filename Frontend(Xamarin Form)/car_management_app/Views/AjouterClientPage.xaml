<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="car_management_app.Views.AjouterClientPage">
    <ContentPage.Content>
        <StackLayout Padding="10">
            <Label Text="Ajouter un client" FontSize="Large" HorizontalOptions="Center" />

            <Entry Placeholder="Nom" Text="{Binding Nom}" />
            <Entry Placeholder="Prénom" Text="{Binding Prenom}" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Téléphone" Text="{Binding Telephone}" Keyboard="Telephone" />

            <Button Text="Ajouter" Command="{Binding AjouterClientCommand}" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
