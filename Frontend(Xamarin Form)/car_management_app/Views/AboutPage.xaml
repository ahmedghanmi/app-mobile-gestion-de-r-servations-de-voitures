<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:car_management_app.ViewModels"
             x:Class="car_management_app.Views.AboutPage"
             BackgroundColor="#F7F9FC"
             Title="Accueil">

    <ContentPage.BindingContext>
        <vm:AboutViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Couleur Accent -->
            <Color x:Key="Accent">#3498db</Color>

            <!-- Style des Boutons -->
            <Style TargetType="Button">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="Medium" />
                <Setter Property="Padding" Value="10" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20" RowSpacing="20">
        <!-- Entête avec une image et un titre -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0" HorizontalOptions="Center">
            <Image Source="car_logo.png" HeightRequest="100" />
            <Label Text="Car Management App"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Accent}"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Section des options -->
        <StackLayout Grid.Row="1" VerticalOptions="CenterAndExpand" Spacing="20">
            <Button Text="Gérer les voitures"
                    Command="{Binding GererVoituresCommand}" />
            <Button Text="Gérer les Réservations" 
                    Command="{Binding GererReservationsCommand}" />
            <Button Text="Gérer les Clients"
                    Command="{Binding GererClientsCommand}" />
            <Button Text="À propos"
                    Command="{Binding AboutCommand}" />
            <Button Text="Contact"
                    Command="{Binding ContactCommand}" />
        </StackLayout>
    </Grid>

</ContentPage>
